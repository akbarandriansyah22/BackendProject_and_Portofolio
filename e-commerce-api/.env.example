# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=ecommerce
DB_SSLMODE=disable

# JWT (min 32 chars; generate: openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32-value-here
JWT_EXPIRATION_HOURS=24

# Metrics endpoint bearer token (min 32 chars)
METRICS_TOKEN=replace-with-openssl-rand-hex-32-value-here

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization

# Application
APP_NAME=E-Commerce API
APP_VERSION=1.0.0
LOG_LEVEL=info
